# Application settings (design §5, §14). Values under REQUIRED have no default on purpose: the services
# refuse to start until they are set.
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
OIDC_ISSUER=http://localhost:8081/realms/dataact
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/dataact
OIDC_AUDIENCE=dataact-api
OIDC_PORTAL_CLIENT_ID=portal
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=dataact
KEYCLOAK_ADMIN_CLIENT_ID=dak-admin
KEYCLOAK_ADMIN_CLIENT_SECRET_FILE=/run/secrets/keycloak_dak_admin_secret
MQTT_URL=mqtts://mosquitto:8884
MQTT_USERNAME=dak-service
MQTT_PASSWORD_FILE=/run/secrets/mqtt_service_password
MQTT_CA_FILE=/certs/ca.crt
KEK_ID=local-1
KEK_FILE=/run/secrets/kek
FINGERPRINT_SECRET_FILE=/run/secrets/fingerprint
GATEKEEPERS_FILE=/config/gatekeepers.json
TEMPLATES_DIR=/templates
DOCUMENT_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
DOCUMENT_FONT_BOLD_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
RATE_LIMIT_PER_MINUTE=600
LLM_URL=http://llm:8080
LLM_MODEL=local
MAVT_URL=http://mavt:4242
# Create an API key in MAVT (API keys) and write it to deploy/secrets/mavt_api_key (README).
MAVT_API_KEY_FILE=/run/secrets/mavt_api_key

# REQUIRED — decided by counsel (design §5.8, §14 question 4):
ACCESS_LOG_RETENTION_DAYS=
REQUEST_DEADLINE_HOURS=
