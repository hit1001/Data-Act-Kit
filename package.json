{
  "name": "dataact-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/edge"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "test:it": "scripts/it.sh",
    "check": "npm run typecheck && npm test",
    "trace": "node scripts/traceability.ts unit.tap it.tap",
    "test:tap": "node --test --test-reporter=tap --test-reporter-destination=unit.tap \"packages/*/test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
